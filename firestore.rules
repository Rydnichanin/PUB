rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasRole(roles) {
      return signedIn() && myUser().role in roles && myUser().active != false;
    }
    function activeStaff() {
      return hasRole(['cashier', 'kitchen', 'courier', 'dispatcher', 'manager', 'admin', 'boss', 'superadmin']);
    }
    function manager() { return hasRole(['manager', 'admin', 'boss', 'superadmin']); }
    function boss() { return hasRole(['boss', 'superadmin']); }
    function superAdmin() { return hasRole(['superadmin']); }

    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'client'
        && request.resource.data.active == true;
      allow read: if signedIn() && (request.auth.uid == uid || boss()
        || (hasRole(['dispatcher']) && resource.data.role == 'courier'));
      allow update: if superAdmin()
        || (hasRole(['boss']) && request.resource.data.role != 'superadmin'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'active', 'updatedAt']))
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'email', 'updatedAt'])
          && request.resource.data.role == resource.data.role
          && request.resource.data.active == resource.data.active);
      allow delete: if superAdmin();
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if manager();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow create, update: if boss();
      allow delete: if superAdmin();
    }

    match /orders/{orderId} {
      allow create: if signedIn() && myUser().active != false
        && ((request.resource.data.clientId == request.auth.uid
              && request.resource.data.status == 'new')
          || (hasRole(['cashier']) && request.resource.data.createdBy == request.auth.uid));
      allow read: if signedIn() && (activeStaff()
        || resource.data.clientId == request.auth.uid
        || (resource.data.courierId == request.auth.uid && hasRole(['courier'])));
      allow update: if superAdmin() || boss()
        || (manager() && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'comment', 'updatedAt', 'courierId', 'courierName']))
        || (hasRole(['cashier']) && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['accepted', 'cancelled'])
        || (hasRole(['kitchen']) && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['accepted', 'cooking', 'ready'])
        || (hasRole(['dispatcher']) && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['courierId', 'courierName', 'status', 'updatedAt'])
          && request.resource.data.status in ['assigned', 'cancelled'])
        || (hasRole(['courier']) && resource.data.courierId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status in ['picked_up', 'delivered']);
      allow delete: if superAdmin();
    }

    match /customerDirectory/{customerId} {
      allow create: if signedIn() && request.auth.uid == customerId
        && request.resource.data.uid == request.auth.uid;
      allow read: if boss() || hasRole(['cashier', 'manager', 'admin']);
      allow update: if boss() || (signedIn() && request.auth.uid == customerId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'phone', 'orderCount', 'lastOrderAt'])
        && request.resource.data.orderCount >= resource.data.orderCount);
      allow delete: if superAdmin();
    }

    match /auditLogs/{logId} {
      allow create: if signedIn() && request.resource.data.actorId == request.auth.uid;
      allow read: if superAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
